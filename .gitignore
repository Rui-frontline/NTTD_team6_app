# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# 環境変数（APIキーなど。絶対にコミットしない）
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS が作るファイル
.DS_Store
Thumbs.db
*.pem

# エディタ
.vscode/*
!.vscode/extensions.json
.idea/

# Claude Code のローカル設定
.claude/settings.local.json
